{
  "name": "lifeflow-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI Life OS — capture-to-routine engine (MVP core)",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'src/**/*.test.ts' 'bench/**/*.test.ts'",
    "build:web": "esbuild src/web/main.ts --bundle --format=esm --outfile=public/bundle.js --sourcemap",
    "web": "esbuild src/web/main.ts --bundle --format=esm --outfile=public/bundle.js --sourcemap --servedir=public --watch",
    "smoke:web": "node scripts/web-smoke.mjs",
    "bench": "node --experimental-strip-types bench/run.ts",
    "serve": "npm run build:web && node --experimental-strip-types server/index.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.0"
  }
}
